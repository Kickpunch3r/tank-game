[ext_resource type="Script" path="res://scripts/debug_hud.gd" id="4_hud"]
[ext_resource type="Script" path="res://scripts/tuning_panel.gd" id="5_tuning_panel"]
[ext_resource type="Script" path="res://scripts/net/controller_server.gd" id="6_controller_server"]
[ext_resource type="Script" path="res://scripts/net/phone_status_label.gd" id="7_phone_label"]
[ext_resource type="Script" path="res://scripts/net/usb_phone_link.gd" id="8_usb_link"]
[ext_resource type="Script" path="res://scripts/preset_switcher.gd" id="9_presets"]
[ext_resource type="Resource" path="res://tuning/presets/heavy.tres" id="10_heavy"]
[ext_resource type="Resource" path="res://tuning/presets/nimble.tres" id="11_nimble"]
[ext_resource type="Resource" path="res://tuning/presets/slippery.tres" id="12_slippery"]
[ext_resource type="PackedScene" path="res://scenes/physics_tank.tscn" id="13_physics_tank"]
[ext_resource type="Script" path="res://scripts/player_rig.gd" id="14_rig"]

[node name="PlayerRig" type="Node3D" node_paths=PackedStringArray("tanks", "chase_camera", "view_switcher", "debug_hud", "tuning_panel", "controller_server")]
script = ExtResource("14_rig")
tanks = [NodePath("Tank"), NodePath("PhysicsTank")]
chase_camera = NodePath("ChaseCamera")
view_switcher = NodePath("ViewSwitcher")
debug_hud = NodePath("DebugHud")
tuning_panel = NodePath("TuningPanel")
controller_server = NodePath("ControllerServer")

[node name="Tank" parent="." instance=ExtResource("1_tank")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1, 0)

[node name="PhysicsTank" parent="." instance=ExtResource("13_physics_tank")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1, 0)

[node name="ChaseCamera" type="Camera3D" parent="." node_paths=PackedStringArray("target")]
current = true
script = ExtResource("2_camera")
target = NodePath("../Tank")

[node name="ViewSwitcher" type="Node" parent="." node_paths=PackedStringArray("views")]
script = ExtResource("3_switcher")
views = [NodePath("../ChaseCamera"), NodePath("../Tank/Visual/Hull/DriverSlitCamera")]

[node name="DebugHud" type="CanvasLayer" parent="." node_paths=PackedStringArray("station", "tank", "view_switcher", "preset_switcher")]
script = ExtResource("4_hud")
station = NodePath("../Tank/DriverStation")
tank = NodePath("../Tank")
view_switcher = NodePath("../ViewSwitcher")
preset_switcher = NodePath("../PresetSwitcher")

[node name="TuningPanel" type="CanvasLayer" parent="." node_paths=PackedStringArray("tank", "chase_camera")]
script = ExtResource("5_tuning_panel")
tank = NodePath("../Tank")
chase_camera = NodePath("../ChaseCamera")

[node name="PresetSwitcher" type="Node" parent="." node_paths=PackedStringArray("tanks", "tuning_panel")]
script = ExtResource("9_presets")
presets = Array[Resource]([ExtResource("10_heavy"), ExtResource("11_nimble"), ExtResource("12_slippery")])
tanks = [NodePath("../Tank"), NodePath("../PhysicsTank")]
tuning_panel = NodePath("../TuningPanel")

[node name="ControllerServer" type="Node" parent="." node_paths=PackedStringArray("tank")]
script = ExtResource("6_controller_server")
tank = NodePath("../Tank")

[node name="UsbPhoneLink" type="Node" parent="." node_paths=PackedStringArray("server")]
script = ExtResource("8_usb_link")
server = NodePath("../ControllerServer")

[node name="PhoneStatusLabel" type="CanvasLayer" parent="." node_paths=PackedStringArray("server", "usb_link")]
script = ExtResource("7_phone_label")
server = NodePath("../ControllerServer")
usb_link = NodePath("../UsbPhoneLink")
